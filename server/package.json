{
  "name": "habit-tracker-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Abgleich-Knotenpunkt f\u00fcr Mac, iPhone und WebApp",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.ts",
    "test": "npm run check && node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
