# macOS
.DS_Store

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Node
node_modules/
dist/
.env
.env.local

# Datenbanken aus lokalen Läufen
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Von XcodeGen erzeugt — die Wahrheit steht in apple/project.yml
apple/*.xcodeproj

# Server
server/node_modules/
server/*.sqlite
server/*.sqlite-shm
server/*.sqlite-wal

# TypeScript-Zwischenstand
*.tsbuildinfo

# Persönliche Team-ID fürs Signieren — gehört niemandem sonst
apple/Signing.xcconfig

# Aus project.yml erzeugt wie das Projekt selbst
apple/HabitTrackerIOS/Info.plist

# Das eingebettete Postgres im lokalen Betrieb
server/pgdaten/

# Die Verbindung zur Datenbank — gehört niemandem sonst
server/.env.local
supabase/.temp/
server/.token.local
